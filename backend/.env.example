# Local development. Copy to .env and edit.
PORT=3001

# Leave USER_POOL_ID / CLIENT_ID empty to run in DEMO AUTH mode (no AWS needed).
# Fill both to verify real Cognito ID tokens locally.
USER_POOL_ID=
CLIENT_ID=

# Leave TABLE_NAME empty to use the in-memory store (saved to .local-data.json).
# Set it to use a real DynamoDB table (or DynamoDB Local via DYNAMODB_ENDPOINT).
TABLE_NAME=
AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT=
